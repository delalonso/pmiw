  << /K [ 780 0 R ]
     /P 784 0 R
     /S /P
     /Pg 690 0 R
     /Type /StructElem
  >>
endobj

782 0 obj
  << /ActualText (Se llega cuando las decisiones producen una celebraci\363n equilibrada\054 sin tanta gente ni movimiento\056\nLa consecuencia es\072\nTodos disfrutan de la celebraci\363n\056 Llegan al momento de la torta\054 se re\372nen alrededor de la mesa\054 encienden las velas y cantan el cumplea\361os\056 La torta est\341 intacta y el d\355a termina bien\056)
     /K [ 46 ]
     /P 783 0 R
     /Pg 690 0 R
     /S /Span
     /Type /StructElem
  >>
endobj

