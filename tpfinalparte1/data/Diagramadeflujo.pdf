778 0 obj
  << /ActualText (Se llega principalmente cuando las decisiones construyen un cumplea\361os tranquilo\072\nPocos invitados \053 decoraci\363n simple \053 m\372sica tranquila \053 fotos y charla\nLa consecuencia es\072\nLa fiesta tiene un ambiente \355ntimo\056 Como se hace tarde\054 algunos invitados se van\054 pero las personas m\341s cercanas se quedan para compartir la torta\056 El cumplea\361os termina siendo un momento especial con la gente mas cercana\056)
     /K [ 44 ]
     /P 779 0 R
     /Pg 690 0 R
     /S /Span
     /Type /StructElem
  >>
endobj

779 0 obj
  << /K [ 778 0 R ]
     /P 784 0 R
     /S /P
     /Pg 690 0 R
     /Type /StructElem
  >>
endobj

780 0 obj
  << /ActualText (Se llega cuando se acumulan las decisiones que aumentan el movimiento\072\nMuchos invitados \053 muchas decoraciones \053 m\372sica fuerte \053 baile\nLa consecuencia es\072\nLa fiesta se vuelve muy intensa\056 Alguien se mueve cerca de la mesa\054 la mesa se desplaza y la torta termina en el piso\056 Aunque el cumplea\361os termina convirti\351ndose en una an\351cdota inesperada\056)
     /K [ 45 ]
     /P 781 0 R
     /Pg 690 0 R
     /S /Span
     /Type /StructElem
  >>
endobj

